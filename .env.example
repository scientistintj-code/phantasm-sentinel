# Comma-separated pool of TinyFish API keys
TINYFISH_API_KEYS=
# TinyFish agent base URL
TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai
# Async SQLAlchemy URL for the local sentinel database
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
# Secret used to sign stored evidence
EVIDENCE_SIGNING_SECRET=
# Browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# Replay a canned demo instead of a live agent run
DEMO_REPLAY=false
# Maximum agent steps allowed in one run
MAX_STEPS_PER_RUN=40
# Maximum wall-clock seconds allowed in one run
MAX_SECONDS_PER_RUN=240
